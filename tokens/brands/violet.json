{
  "$description": "Example brand: violet primary and focus ring, softer button and card corners. Overrides are semantic tokens only. Load ayywi/brands/violet.css and set data-brand=\"violet\" on any element.",
  "color": {
    "primary": { "$type": "color", "$value": "{palette.violet.77}", "$extensions": { "ayywi": { "light": "{palette.violet.58}" } } },
    "primary-fg": { "$type": "color", "$value": "{palette.neutral.0}", "$extensions": { "ayywi": { "light": "{palette.neutral.100}" } } },
    "ring": { "$type": "color", "$value": "{palette.violet.77}", "$extensions": { "ayywi": { "light": "{palette.violet.58}" } } },
    "glow": { "$type": "color", "$value": "{palette.violet.77}", "$extensions": { "ayywi": { "light": "{palette.violet.58}" } } }
  },
  "radius": {
    "button": { "$type": "dimension", "$value": "10px" },
    "card": { "$type": "dimension", "$value": "20px" }
  }
}
