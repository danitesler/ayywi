{
  "$description": "Near-black dark theme in the style of OpenCode: a #0a0a0a page, #141414 cards with a step up for popovers, white text and quiet grey descriptions. Every text colour still meets WCAG AA.",
  "$extensions": { "ayywi": { "base": "dark" } },
  "color": {
    "bg": { "$type": "color", "$value": "{palette.neutral.4}" },
    "surface": { "$type": "color", "$value": "{palette.neutral.8}" },
    "surface-raised": { "$type": "color", "$value": "{palette.neutral.12}" },
    "text": { "$type": "color", "$value": "{palette.neutral.100}" },
    "muted": { "$type": "color", "$value": "{palette.neutral.58}" },
    "border": { "$type": "color", "$value": "{palette.neutral.15}" },
    "ring": { "$type": "color", "$value": "{palette.neutral.100}" },
    "primary": { "$type": "color", "$value": "{palette.neutral.100}" },
    "primary-fg": { "$type": "color", "$value": "{palette.neutral.4}" },
    "destructive": { "$type": "color", "$value": "{palette.red.79}" },
    "info": { "$type": "color", "$value": "{palette.blue.77}" },
    "ai-active": { "$type": "color", "$value": "{palette.violet.84}" },
    "glow": { "$type": "color", "$value": "{palette.neutral.100}" },
    "glass": { "$type": "color", "$value": "#141414c7" },
    "overlay": { "$type": "color", "$value": "#00000099" }
  }
}
