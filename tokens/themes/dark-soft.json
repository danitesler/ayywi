{
  "$description": "Dark with softer contrast: a charcoal background instead of black, and off-white text. Easier on the eyes for long reading; every text colour still meets WCAG AA.",
  "$extensions": { "ayywi": { "base": "dark" } },
  "color": {
    "bg": { "$type": "color", "$value": "{palette.neutral.12}" },
    "surface": { "$type": "color", "$value": "{palette.neutral.15}" },
    "surface-raised": { "$type": "color", "$value": "{palette.neutral.18}" },
    "text": { "$type": "color", "$value": "{palette.neutral.90}" },
    "muted": { "$type": "color", "$value": "{palette.neutral.60}" },
    "border": { "$type": "color", "$value": "{palette.neutral.20}" },
    "ring": { "$type": "color", "$value": "{palette.neutral.90}" },
    "primary": { "$type": "color", "$value": "{palette.neutral.90}" },
    "primary-fg": { "$type": "color", "$value": "{palette.neutral.12}" },
    "destructive": { "$type": "color", "$value": "{palette.red.79}" },
    "info": { "$type": "color", "$value": "{palette.blue.77}" },
    "ai-active": { "$type": "color", "$value": "{palette.violet.84}" },
    "glow": { "$type": "color", "$value": "{palette.neutral.90}" },
    "glass": { "$type": "color", "$value": "#1e1e1ec7" },
    "overlay": { "$type": "color", "$value": "#00000099" }
  }
}
