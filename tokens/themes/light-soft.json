{
  "$description": "Light with softer contrast: an off-white background instead of white, and charcoal text. Less glare; every text colour still meets WCAG AA.",
  "$extensions": { "ayywi": { "base": "light" } },
  "color": {
    "bg": { "$type": "color", "$value": "{palette.neutral.95}" },
    "surface": { "$type": "color", "$value": "{palette.neutral.92}" },
    "surface-raised": { "$type": "color", "$value": "{palette.neutral.98}" },
    "text": { "$type": "color", "$value": "{palette.neutral.15}" },
    "muted": { "$type": "color", "$value": "{palette.neutral.39}" },
    "border": { "$type": "color", "$value": "{palette.neutral.82}" },
    "ring": { "$type": "color", "$value": "{palette.neutral.15}" },
    "primary": { "$type": "color", "$value": "{palette.neutral.15}" },
    "primary-fg": { "$type": "color", "$value": "{palette.neutral.98}" },
    "destructive": { "$type": "color", "$value": "{palette.red.35}" },
    "info": { "$type": "color", "$value": "{palette.blue.40}" },
    "ai": { "$type": "color", "$value": "{palette.neutral.39}" },
    "glass": { "$type": "color", "$value": "#f2f2f2c7" }
  }
}
