{
  "$description": "ayywi design tokens — single source of truth. DTCG-style: $value is the DARK theme value (ayywi is dark-first); $extensions.ayywi.light is the LIGHT value; $extensions.ayywi.density holds comfortable/touch values (compact is $value); $extensions.ayywi.css overrides the emitted CSS (used for theme-derived values). More themes (dark-soft, light-gray…) live in tokens/themes/ and override themed colours of their base theme. References use {group.name}. Run `pnpm generate` after editing.",
  "palette": {
    "$description": "Primitive colours. The number is the HSL lightness % — higher is lighter. Components never use these directly; semantic color.* and accent.* tokens reference them.",
    "neutral": {
      "0": { "$type": "color", "$value": "#000000" },
      "4": { "$type": "color", "$value": "#0a0a0a" },
      "8": { "$type": "color", "$value": "#141414" },
      "12": { "$type": "color", "$value": "#1e1e1e" },
      "15": { "$type": "color", "$value": "#262626" },
      "18": { "$type": "color", "$value": "#2e2e2e" },
      "20": { "$type": "color", "$value": "#333333" },
      "28": { "$type": "color", "$value": "#474747" },
      "39": { "$type": "color", "$value": "#636363" },
      "42": { "$type": "color", "$value": "#6b6b6b" },
      "58": { "$type": "color", "$value": "#939393" },
      "60": { "$type": "color", "$value": "#9a9a9a" },
      "73": { "$type": "color", "$value": "#bbbbbb" },
      "85": { "$type": "color", "$value": "#dadada" },
      "90": { "$type": "color", "$value": "#e5e5e5" },
      "92": { "$type": "color", "$value": "#ebebeb" },
      "97": { "$type": "color", "$value": "#f7f7f8" },
      "100": { "$type": "color", "$value": "#ffffff" }
    },
    "red": {
      "35": { "$type": "color", "$value": "#991b1b" },
      "42": { "$type": "color", "$value": "#b91c1c" },
      "51": { "$type": "color", "$value": "#dc2626" },
      "71": { "$type": "color", "$value": "#f87171" },
      "79": { "$type": "color", "$value": "#fb9696" }
    },
    "green": {
      "20": { "$type": "color", "$value": "#065f46" },
      "24": { "$type": "color", "$value": "#047857" },
      "51": { "$type": "color", "$value": "#35d07f" }
    },
    "amber": {
      "31": { "$type": "color", "$value": "#92400e" },
      "37": { "$type": "color", "$value": "#b45309" },
      "61": { "$type": "color", "$value": "#f5c542" }
    },
    "blue": {
      "40": { "$type": "color", "$value": "#1e40af" },
      "48": { "$type": "color", "$value": "#1d4ed8" },
      "53": { "$type": "color", "$value": "#2563eb" },
      "68": { "$type": "color", "$value": "#5b9dff" },
      "77": { "$type": "color", "$value": "#8ab9ff" }
    },
    "violet": {
      "50": { "$type": "color", "$value": "#6d28d9" },
      "58": { "$type": "color", "$value": "#7c3aed" },
      "77": { "$type": "color", "$value": "#b98cff" },
      "84": { "$type": "color", "$value": "#cbabff" }
    },
    "emerald": {
      "52": { "$type": "color", "$value": "#34d399" }
    },
    "pink": {
      "70": { "$type": "color", "$value": "#f472b6" }
    },
    "orange": {
      "65": { "$type": "color", "$value": "#ff8a4c" }
    }
  },
  "color": {
    "$extensions": {
      "ayywi": {
        "categories": {
          "Surfaces": ["bg", "surface", "surface-raised", "glass", "overlay"],
          "Text": ["text", "text-soft", "muted"],
          "Lines": ["border", "hairline", "line", "line-strong", "line-hover"],
          "Interactive": ["primary", "primary-fg", "ring", "wash", "wash-hover", "highlight"],
          "Status": ["success", "warning", "destructive", "info"],
          "AI": ["ai", "ai-active"],
          "Effects": ["glow", "shadow"]
        }
      }
    },
    "bg": { "$type": "color", "$value": "{palette.neutral.0}", "$description": "Page background.", "$extensions": { "ayywi": { "light": "{palette.neutral.100}" } } },
    "surface": { "$type": "color", "$value": "{palette.neutral.4}", "$description": "Cards, panels, inputs sit on this.", "$extensions": { "ayywi": { "light": "{palette.neutral.97}" } } },
    "surface-raised": { "$type": "color", "$value": "{palette.neutral.8}", "$description": "Popovers, menus, tooltips, toasts.", "$extensions": { "ayywi": { "light": "{palette.neutral.100}" } } },
    "text": { "$type": "color", "$value": "{palette.neutral.100}", "$description": "Primary text. Also the base every line/wash is mixed from.", "$extensions": { "ayywi": { "light": "{palette.neutral.4}" } } },
    "text-soft": { "$type": "color", "$value": "{palette.neutral.73}", "$description": "Secondary text that still needs to read comfortably.", "$extensions": { "ayywi": { "light": "{palette.neutral.28}" } } },
    "muted": { "$type": "color", "$value": "{palette.neutral.58}", "$description": "Captions, placeholders, de-emphasised labels.", "$extensions": { "ayywi": { "light": "{palette.neutral.42}" } } },
    "border": { "$type": "color", "$value": "{palette.neutral.15}", "$description": "Opaque border, for places where a mixed line can't be used.", "$extensions": { "ayywi": { "light": "{palette.neutral.85}" } } },
    "ring": { "$type": "color", "$value": "{palette.neutral.100}", "$description": "Focus ring.", "$extensions": { "ayywi": { "light": "{palette.neutral.4}" } } },
    "primary": { "$type": "color", "$value": "{palette.neutral.100}", "$description": "Primary action fill. Monochrome by design; brands usually override it.", "$extensions": { "ayywi": { "light": "{palette.neutral.4}" } } },
    "primary-fg": { "$type": "color", "$value": "{palette.neutral.0}", "$description": "Text on primary.", "$extensions": { "ayywi": { "light": "{palette.neutral.100}" } } },
    "destructive": { "$type": "color", "$value": "{palette.red.71}", "$description": "Errors and destructive actions.", "$extensions": { "ayywi": { "light": "{palette.red.42}" } } },
    "success": { "$type": "color", "$value": "{palette.green.51}", "$description": "Positive status.", "$extensions": { "ayywi": { "light": "{palette.green.20}" } } },
    "warning": { "$type": "color", "$value": "{palette.amber.61}", "$description": "Caution status.", "$extensions": { "ayywi": { "light": "{palette.amber.31}" } } },
    "info": { "$type": "color", "$value": "{palette.blue.68}", "$description": "Informational status.", "$extensions": { "ayywi": { "light": "{palette.blue.48}" } } },
    "ai": { "$type": "color", "$value": "{palette.neutral.60}", "$description": "AI features at rest.", "$extensions": { "ayywi": { "light": "{palette.neutral.42}" } } },
    "ai-active": { "$type": "color", "$value": "{palette.violet.77}", "$description": "AI features while active / generating.", "$extensions": { "ayywi": { "light": "{palette.violet.50}" } } },
    "glow": { "$type": "color", "$value": "{palette.neutral.100}", "$description": "Glow source colour (mixed down, never used raw).", "$extensions": { "ayywi": { "light": "#00000073" } } },
    "shadow": { "$type": "color", "$value": "{palette.neutral.0}", "$description": "Shadow source colour (mixed down, never used raw).", "$extensions": { "ayywi": { "light": "#0000004d" } } },
    "glass": { "$type": "color", "$value": "#000000bf", "$description": "Translucent chrome (sticky headers, sidebars). Pair with backdrop-filter.", "$extensions": { "ayywi": { "light": "#ffffffc7" } } },
    "overlay": { "$type": "color", "$value": "#000000bf", "$description": "Modal backdrop.", "$extensions": { "ayywi": { "light": "#0a0a0a73" } } },

    "wash": { "$type": "color", "$value": "#ffffff0a", "$description": "4% text mix. Resting fill for subtle controls (badges, tab lists, secondary buttons).", "$extensions": { "ayywi": { "light": "#0a0a0a0a", "css": "color-mix(in srgb, var(--ayy-color-text) 4%, transparent)" } } },
    "highlight": { "$type": "color", "$value": "#ffffff0f", "$description": "6% text mix. Inset top highlight on cards and dialogs.", "$extensions": { "ayywi": { "light": "#0a0a0a0f", "css": "color-mix(in srgb, var(--ayy-color-text) 6%, transparent)" } } },
    "wash-hover": { "$type": "color", "$value": "#ffffff14", "$description": "8% text mix. Hover fill.", "$extensions": { "ayywi": { "light": "#0a0a0a14", "css": "color-mix(in srgb, var(--ayy-color-text) 8%, transparent)" } } },
    "hairline": { "$type": "color", "$value": "#ffffff14", "$description": "8% text mix. Table rows, quiet dividers.", "$extensions": { "ayywi": { "light": "#0a0a0a14", "css": "color-mix(in srgb, var(--ayy-color-text) 8%, transparent)" } } },
    "line": { "$type": "color", "$value": "#ffffff1f", "$description": "12% text mix. Card and secondary-control borders.", "$extensions": { "ayywi": { "light": "#0a0a0a1f", "css": "color-mix(in srgb, var(--ayy-color-text) 12%, transparent)" } } },
    "line-strong": { "$type": "color", "$value": "#ffffff24", "$description": "14% text mix. Inputs, outline buttons, badges, dialogs.", "$extensions": { "ayywi": { "light": "#0a0a0a24", "css": "color-mix(in srgb, var(--ayy-color-text) 14%, transparent)" } } },
    "line-hover": { "$type": "color", "$value": "#ffffff40", "$description": "25% text mix. Hovered borders.", "$extensions": { "ayywi": { "light": "#0a0a0a40", "css": "color-mix(in srgb, var(--ayy-color-text) 25%, transparent)" } } }
  },
  "accent": {
    "$description": "Spot colours. The frame is monochrome; colour comes from the content (categories, spotlights, charts). Same in both themes.",
    "research": { "$type": "color", "$value": "{palette.amber.61}" },
    "product": { "$type": "color", "$value": "{palette.blue.68}" },
    "ai": { "$type": "color", "$value": "{palette.violet.77}" },
    "system": { "$type": "color", "$value": "{palette.emerald.52}" },
    "brand": { "$type": "color", "$value": "{palette.pink.70}" },
    "marketing": { "$type": "color", "$value": "{palette.orange.65}" }
  },
  "font": {
    "heading": { "$type": "fontFamily", "$value": ["Unbounded", "Arial Black", "system-ui", "-apple-system", "Segoe UI", "Roboto", "Noto Sans", "sans-serif"], "$description": "Headings and big numbers. Unbounded covers Latin and Cyrillic; other scripts fall through to the system font." },
    "body": { "$type": "fontFamily", "$value": ["Sora", "system-ui", "-apple-system", "Segoe UI", "Roboto", "Noto Sans", "Helvetica Neue", "Arial", "sans-serif"], "$description": "Body and UI text. Always ends in system fonts so CJK, Arabic, Cyrillic, Devanagari etc. render natively." },
    "signature": { "$type": "fontFamily", "$value": ["Caveat", "Segoe Script", "cursive"], "$description": "Handwritten accent. Decorative only." },
    "mono": { "$type": "fontFamily", "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "Monaco", "Consolas", "Noto Sans Mono", "monospace"] }
  },
  "text": {
    "$description": "Type scale in rem so it respects the user's browser font size.",
    "2xs": { "$type": "dimension", "$value": "0.6875rem", "$description": "11px — badges, table headers, eyebrows." },
    "xs": { "$type": "dimension", "$value": "0.75rem", "$description": "12px — dense captions." },
    "sm": { "$type": "dimension", "$value": "0.875rem", "$description": "14px — body in dense UIs, descriptions." },
    "md": { "$type": "dimension", "$value": "1rem", "$description": "16px — body." },
    "lg": { "$type": "dimension", "$value": "1.125rem", "$description": "18px — lede." },
    "xl": { "$type": "dimension", "$value": "1.375rem", "$description": "22px — card titles." },
    "2xl": { "$type": "dimension", "$value": "1.75rem", "$description": "28px — H3." },
    "3xl": { "$type": "dimension", "$value": "2.25rem", "$description": "36px — H2." },
    "4xl": { "$type": "dimension", "$value": "3rem", "$description": "48px — H1 / metrics." },
    "display": { "$type": "dimension", "$value": "clamp(2.75rem, 13vw, 12.5rem)", "$description": "Fluid hero title, 44px on a phone to 200px on a wide screen. CSS only; platform exports skip it." }
  },
  "weight": {
    "regular": { "$type": "fontWeight", "$value": 400 },
    "medium": { "$type": "fontWeight", "$value": 500 },
    "semibold": { "$type": "fontWeight", "$value": 600 },
    "bold": { "$type": "fontWeight", "$value": 700 }
  },
  "leading": {
    "none": { "$type": "number", "$value": 1 },
    "tight": { "$type": "number", "$value": 1.2 },
    "snug": { "$type": "number", "$value": 1.35 },
    "normal": { "$type": "number", "$value": 1.55 },
    "display": { "$type": "number", "$value": 0.9, "$description": "Display titles: lines sit close enough to read as one block." }
  },
  "tracking": {
    "tight": { "$type": "dimension", "$value": "-0.01em" },
    "wide": { "$type": "dimension", "$value": "0.06em" },
    "eyebrow": { "$type": "dimension", "$value": "0.14em" },
    "display": { "$type": "dimension", "$value": "-0.03em", "$description": "Display titles." }
  },
  "space": {
    "$description": "4px grid. Half steps (0-5, 1-5) are for dense UI only.",
    "0-5": { "$type": "dimension", "$value": "0.125rem" },
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "1-5": { "$type": "dimension", "$value": "0.375rem" },
    "2": { "$type": "dimension", "$value": "0.5rem" },
    "3": { "$type": "dimension", "$value": "0.75rem" },
    "4": { "$type": "dimension", "$value": "1rem" },
    "5": { "$type": "dimension", "$value": "1.25rem" },
    "6": { "$type": "dimension", "$value": "1.5rem" },
    "8": { "$type": "dimension", "$value": "2rem" },
    "10": { "$type": "dimension", "$value": "2.5rem" },
    "12": { "$type": "dimension", "$value": "3rem" },
    "16": { "$type": "dimension", "$value": "4rem" },
    "20": { "$type": "dimension", "$value": "5rem", "$description": "Section padding on phones." },
    "24": { "$type": "dimension", "$value": "6rem", "$description": "Section padding." },
    "32": { "$type": "dimension", "$value": "8rem", "$description": "Section padding on wide screens." }
  },
  "size": {
    "$description": "Component sizes. Density-aware ones change with data-density (compact is the default; touch screens get touch automatically).",
    "control-sm": { "$type": "dimension", "$value": "1.75rem", "$description": "Small control height.", "$extensions": { "ayywi": { "density": { "comfortable": "2rem", "touch": "2.5rem" } } } },
    "control-md": { "$type": "dimension", "$value": "2rem", "$description": "Default control height.", "$extensions": { "ayywi": { "density": { "comfortable": "2.5rem", "touch": "2.75rem" } } } },
    "control-lg": { "$type": "dimension", "$value": "2.5rem", "$description": "Large control height.", "$extensions": { "ayywi": { "density": { "comfortable": "3rem", "touch": "3.25rem" } } } },
    "switch": { "$type": "dimension", "$value": "1.25rem", "$description": "Switch track height (width is 1.8×).", "$extensions": { "ayywi": { "density": { "comfortable": "1.375rem", "touch": "1.625rem" } } } },
    "check": { "$type": "dimension", "$value": "1rem", "$description": "Checkbox and radio box size.", "$extensions": { "ayywi": { "density": { "comfortable": "1.125rem", "touch": "1.25rem" } } } },
    "touch": { "$type": "dimension", "$value": "2.75rem", "$description": "44px minimum touch target." },
    "container": { "$type": "dimension", "$value": "87.5rem", "$description": "Widest page content (1400px): navbar, hero, grids. Used by .ayy-container." },
    "measure": { "$type": "dimension", "$value": "46rem", "$description": "Comfortable reading width for long text (~70 characters). Used by .ayy-prose." },
    "header": { "$type": "dimension", "$value": "4.5rem", "$description": "Navbar height; sticky elements and anchor targets sit below it." }
  },
  "control": {
    "$description": "Text size and inline padding of buttons and form controls. Density-aware; touch keeps inputs at 16px so iOS doesn't zoom on focus.",
    "text-sm": { "$type": "dimension", "$value": "0.6875rem", "$extensions": { "ayywi": { "density": { "comfortable": "0.75rem", "touch": "0.875rem" } } } },
    "text-md": { "$type": "dimension", "$value": "0.75rem", "$extensions": { "ayywi": { "density": { "comfortable": "0.875rem", "touch": "1rem" } } } },
    "text-lg": { "$type": "dimension", "$value": "0.875rem", "$extensions": { "ayywi": { "density": { "comfortable": "1rem", "touch": "1.125rem" } } } },
    "pad-sm": { "$type": "dimension", "$value": "0.75rem", "$extensions": { "ayywi": { "density": { "comfortable": "0.875rem", "touch": "1rem" } } } },
    "pad-md": { "$type": "dimension", "$value": "1rem", "$extensions": { "ayywi": { "density": { "comfortable": "1.125rem", "touch": "1.25rem" } } } },
    "pad-lg": { "$type": "dimension", "$value": "1.5rem", "$extensions": { "ayywi": { "density": { "comfortable": "1.5rem", "touch": "1.75rem" } } } }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "4px" },
    "md": { "$type": "dimension", "$value": "6px" },
    "lg": { "$type": "dimension", "$value": "8px" },
    "xl": { "$type": "dimension", "$value": "12px" },
    "2xl": { "$type": "dimension", "$value": "16px" },
    "3xl": { "$type": "dimension", "$value": "24px" },
    "pill": { "$type": "dimension", "$value": "999px" },
    "control": { "$type": "dimension", "$value": "{radius.xl}", "$description": "Inputs, selects, textareas, tooltips, menus." },
    "card": { "$type": "dimension", "$value": "{radius.2xl}", "$description": "Cards, dialogs, popovers." },
    "button": { "$type": "dimension", "$value": "{radius.pill}", "$description": "Buttons, tabs, badges." }
  },
  "shadow": {
    "rest": { "$type": "shadow", "$value": "inset 0 1px 0 #ffffff0f", "$description": "Inset top highlight. Cards at rest.", "$extensions": { "ayywi": { "light": "inset 0 1px 0 #0a0a0a0f", "css": "inset 0 1px 0 var(--ayy-color-highlight)" } } },
    "lift": { "$type": "shadow", "$value": "0 16px 36px #00000066", "$description": "Hovered / lifted cards.", "$extensions": { "ayywi": { "light": "0 16px 36px #0000001f", "css": "0 16px 36px color-mix(in srgb, var(--ayy-color-shadow) 40%, transparent)" } } },
    "overlay": { "$type": "shadow", "$value": "0 24px 60px #00000080", "$description": "Dialogs, menus, popovers, tooltips, toasts.", "$extensions": { "ayywi": { "light": "0 24px 60px #00000026", "css": "0 24px 60px color-mix(in srgb, var(--ayy-color-shadow) 50%, transparent)" } } },
    "glow": { "$type": "shadow", "$value": "0 0 18px #ffffff2e", "$description": "Primary button hover glow.", "$extensions": { "ayywi": { "light": "0 0 18px #0000001a", "css": "0 0 18px color-mix(in srgb, var(--ayy-color-glow) 18%, transparent)" } } },
    "frame": { "$type": "shadow", "$value": "0 30px 80px -40px #000000e6", "$description": "Screenshots and browser frames: a long, soft drop under the image.", "$extensions": { "ayywi": { "light": "0 30px 80px -40px #0000004d", "css": "0 30px 80px -40px color-mix(in srgb, var(--ayy-color-shadow) 90%, transparent)" } } }
  },
  "ease": {
    "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] },
    "spring": { "$type": "cubicBezier", "$value": [0.175, 0.885, 0.32, 1.275], "$description": "Slight overshoot. Small lifts and toggles." },
    "out-expo": { "$type": "cubicBezier", "$value": [0.25, 1, 0.5, 1], "$description": "Default for entrances and card lifts." },
    "menu": { "$type": "cubicBezier", "$value": [0.22, 1, 0.36, 1], "$description": "Menus, dialogs, popovers." }
  },
  "duration": {
    "fast": { "$type": "duration", "$value": "150ms" },
    "base": { "$type": "duration", "$value": "300ms" },
    "slow": { "$type": "duration", "$value": "450ms" },
    "slower": { "$type": "duration", "$value": "600ms" }
  },
  "z": {
    "sticky": { "$type": "number", "$value": 20 },
    "overlay": { "$type": "number", "$value": 50 },
    "tooltip": { "$type": "number", "$value": 60 },
    "toast": { "$type": "number", "$value": 70 }
  }
}
