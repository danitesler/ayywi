{
  "$description": "ayywi design tokens — single source of truth. DTCG-style: $value is the DARK theme value (ayywi is dark-first); $extensions.ayywi.light is the LIGHT value; $extensions.ayywi.density holds comfortable/touch values (compact is $value); $extensions.ayywi.css overrides the emitted CSS (used for theme-derived values). More themes (dark-contrast, light-gray…) live in tokens/themes/ and override themed colours of their base theme. References use {group.name}. Run `pnpm generate` after editing.",
  "palette": {
    "$description": "Primitive colours. The number is the HSL lightness % — higher is lighter. Components never use these directly; semantic color.* and accent.* tokens reference them.",
    "neutral": {
      "0": { "$type": "color", "$value": "#000000" },
      "4": { "$type": "color", "$value": "#0a0a0a" },
      "8": { "$type": "color", "$value": "#141414" },
      "12": { "$type": "color", "$value": "#1e1e1e" },
      "15": { "$type": "color", "$value": "#262626" },
      "18": { "$type": "color", "$value": "#2e2e2e" },
      "20": { "$type": "color", "$value": "#333333" },
      "28": { "$type": "color", "$value": "#474747" },
      "39": { "$type": "color", "$value": "#636363" },
      "42": { "$type": "color", "$value": "#6b6b6b" },
      "58": { "$type": "color", "$value": "#939393" },
      "60": { "$type": "color", "$value": "#9a9a9a" },
      "73": { "$type": "color", "$value": "#bbbbbb" },
      "85": { "$type": "color", "$value": "#dadada" },
      "90": { "$type": "color", "$value": "#e5e5e5" },
      "92": { "$type": "color", "$value": "#ebebeb" },
      "97": { "$type": "color", "$value": "#f7f7f8" },
      "100": { "$type": "color", "$value": "#ffffff" }
    },
    "red": {
      "35": { "$type": "color", "$value": "#991b1b" },
      "42": { "$type": "color", "$value": "#b91c1c" },
      "51": { "$type": "color", "$value": "#dc2626" },
      "71": { "$type": "color", "$value": "#f87171" },
      "79": { "$type": "color", "$value": "#fb9696" }
    },
    "green": {
      "20": { "$type": "color", "$value": "#065f46" },
      "24": { "$type": "color", "$value": "#047857" },
      "51": { "$type": "color", "$value": "#35d07f" }
    },
    "amber": {
      "31": { "$type": "color", "$value": "#92400e" },
      "37": { "$type": "color", "$value": "#b45309" },
      "61": { "$type": "color", "$value": "#f5c542" }
    },
    "blue": {
      "40": { "$type": "color", "$value": "#1e40af" },
      "48": { "$type": "color", "$value": "#1d4ed8" },
      "53": { "$type": "color", "$value": "#2563eb" },
      "68": { "$type": "color", "$value": "#5b9dff" },
      "77": { "$type": "color", "$value": "#8ab9ff" }
    },
    "violet": {
      "50": { "$type": "color", "$value": "#6d28d9" },
      "58": { "$type": "color", "$value": "#7c3aed" },
      "77": { "$type": "color", "$value": "#b98cff" },
      "84": { "$type": "color", "$value": "#cbabff" }
    },
    "emerald": {
      "52": { "$type": "color", "$value": "#34d399" }
    },
    "pink": {
      "42": { "$type": "color", "$value": "#be185d" },
      "70": { "$type": "color", "$value": "#f472b6" }
    },
    "orange": {
      "40": { "$type": "color", "$value": "#c2410c" },
      "65": { "$type": "color", "$value": "#ff8a4c" }
    }
  },
  "color": {
    "$extensions": {
      "ayywi": {
        "categories": {
          "Surfaces": ["bg", "surface", "surface-raised", "glass", "overlay"],
          "Text": ["text", "text-soft", "muted"],
          "Lines": ["border", "hairline", "line", "line-strong", "line-hover"],
          "Interactive": ["primary", "primary-fg", "ring", "wash", "wash-hover", "highlight"],
          "Status": ["success", "warning", "destructive", "info"],
          "AI": ["ai", "ai-active"],
          "Effects": ["glow", "shadow"]
        }
      }
    },
    "bg": { "$type": "color", "$value": "{palette.neutral.4}", "$description": "The page behind everything.", "$extensions": { "ayywi": { "light": "{palette.neutral.100}" } } },
    "surface": { "$type": "color", "$value": "{palette.neutral.8}", "$description": "Cards, panels and inputs, one step above the page.", "$extensions": { "ayywi": { "light": "{palette.neutral.97}" } } },
    "surface-raised": { "$type": "color", "$value": "{palette.neutral.12}", "$description": "Things that float above the page: popovers, menus, tooltips and toasts.", "$extensions": { "ayywi": { "light": "{palette.neutral.100}" } } },
    "text": { "$type": "color", "$value": "{palette.neutral.100}", "$description": "Main text and icons. Every line and wash is made from it, so they follow the theme.", "$extensions": { "ayywi": { "light": "{palette.neutral.4}" } } },
    "text-soft": { "$type": "color", "$value": "{palette.neutral.73}", "$description": "Secondary text that still has to be easy to read.", "$extensions": { "ayywi": { "light": "{palette.neutral.28}" } } },
    "muted": { "$type": "color", "$value": "{palette.neutral.58}", "$description": "Quiet text: captions, placeholders and labels that shouldn't compete.", "$extensions": { "ayywi": { "light": "{palette.neutral.42}" } } },
    "border": { "$type": "color", "$value": "{palette.neutral.15}", "$description": "A solid border, for places where a see-through line wouldn't work.", "$extensions": { "ayywi": { "light": "{palette.neutral.85}" } } },
    "ring": { "$type": "color", "$value": "{palette.neutral.100}", "$description": "The outline that shows where keyboard focus is.", "$extensions": { "ayywi": { "light": "{palette.neutral.4}" } } },
    "primary": { "$type": "color", "$value": "{palette.neutral.100}", "$description": "Primary action fill. Monochrome by design; a brand (setBrand(), @danitesler/ayywi/brands/<name>.css) sets it, with primary-fg and ring, from its seed colour.", "$extensions": { "ayywi": { "light": "{palette.neutral.4}" } } },
    "primary-fg": { "$type": "color", "$value": "{palette.neutral.4}", "$description": "Text on primary.", "$extensions": { "ayywi": { "light": "{palette.neutral.100}" } } },
    "destructive": { "$type": "color", "$value": "{palette.red.79}", "$description": "Errors, and actions that delete or can't be undone.", "$extensions": { "ayywi": { "light": "{palette.red.42}" } } },
    "success": { "$type": "color", "$value": "{palette.green.51}", "$description": "Something went well or is healthy.", "$extensions": { "ayywi": { "light": "{palette.green.20}" } } },
    "warning": { "$type": "color", "$value": "{palette.amber.61}", "$description": "Something needs attention but isn't broken.", "$extensions": { "ayywi": { "light": "{palette.amber.31}" } } },
    "info": { "$type": "color", "$value": "{palette.blue.77}", "$description": "Neutral information worth noticing.", "$extensions": { "ayywi": { "light": "{palette.blue.48}" } } },
    "ai": { "$type": "color", "$value": "{palette.neutral.60}", "$description": "Marks AI features when idle.", "$extensions": { "ayywi": { "light": "{palette.neutral.42}" } } },
    "ai-active": { "$type": "color", "$value": "{palette.violet.84}", "$description": "Marks AI features while they're working.", "$extensions": { "ayywi": { "light": "{palette.violet.50}" } } },
    "glow": { "$type": "color", "$value": "{palette.neutral.100}", "$description": "The colour glows are made from. It's always softened before use.", "$extensions": { "ayywi": { "light": "#00000073" } } },
    "shadow": { "$type": "color", "$value": "{palette.neutral.0}", "$description": "The colour shadows are made from. It's always softened before use.", "$extensions": { "ayywi": { "light": "#0000004d" } } },
    "glass": { "$type": "color", "$value": "#141414c7", "$description": "See-through chrome like sticky headers and sidebars. Use it with a backdrop blur.", "$extensions": { "ayywi": { "light": "#ffffffc7" } } },
    "overlay": { "$type": "color", "$value": "#00000099", "$description": "The dim layer behind a modal.", "$extensions": { "ayywi": { "light": "#0a0a0a73" } } },

    "wash": { "$type": "color", "$value": "#ffffff0a", "$description": "A faint fill for quiet controls at rest, like badges, tab lists and secondary buttons.", "$extensions": { "ayywi": { "light": "#0a0a0a0a", "css": "color-mix(in srgb, var(--ayy-color-text) 4%, transparent)" } } },
    "highlight": { "$type": "color", "$value": "#ffffff0f", "$description": "A soft light edge along the top of cards and dialogs.", "$extensions": { "ayywi": { "light": "#0a0a0a0f", "css": "color-mix(in srgb, var(--ayy-color-text) 6%, transparent)" } } },
    "wash-hover": { "$type": "color", "$value": "#ffffff14", "$description": "The fill a control takes on hover.", "$extensions": { "ayywi": { "light": "#0a0a0a14", "css": "color-mix(in srgb, var(--ayy-color-text) 8%, transparent)" } } },
    "hairline": { "$type": "color", "$value": "#ffffff14", "$description": "The faintest line, for table rows and quiet dividers.", "$extensions": { "ayywi": { "light": "#0a0a0a14", "css": "color-mix(in srgb, var(--ayy-color-text) 8%, transparent)" } } },
    "line": { "$type": "color", "$value": "#ffffff1f", "$description": "Borders of cards and secondary controls.", "$extensions": { "ayywi": { "light": "#0a0a0a1f", "css": "color-mix(in srgb, var(--ayy-color-text) 12%, transparent)" } } },
    "line-strong": { "$type": "color", "$value": "#ffffff24", "$description": "Slightly firmer borders for inputs, outline buttons, badges and dialogs.", "$extensions": { "ayywi": { "light": "#0a0a0a24", "css": "color-mix(in srgb, var(--ayy-color-text) 14%, transparent)" } } },
    "line-hover": { "$type": "color", "$value": "#ffffff40", "$description": "A border that gets darker on hover.", "$extensions": { "ayywi": { "light": "#0a0a0a40", "css": "color-mix(in srgb, var(--ayy-color-text) 25%, transparent)" } } }
  },
  "accent": {
    "$description": "Spot colours for content that needs its own identity, like a category or a spotlight. The interface itself stays monochrome, and these look the same in every theme. Charts use chart.* instead.",
    "research": { "$type": "color", "$value": "{palette.amber.61}" },
    "product": { "$type": "color", "$value": "{palette.blue.68}" },
    "ai": { "$type": "color", "$value": "{palette.violet.77}" },
    "system": { "$type": "color", "$value": "{palette.emerald.52}" },
    "brand": { "$type": "color", "$value": "{palette.pink.70}" },
    "marketing": { "$type": "color", "$value": "{palette.orange.65}" }
  },
  "chart": {
    "$description": "Data series, in order: the first series is chart.1, the second chart.2… Darker on light themes, so every one keeps 3:1 against every surface (pnpm check measures it); the order keeps neighbours apart for colour-blind readers. Chart libraries can use them too: var(--ayy-chart-1) in SVG, chartColors() for canvas.",
    "1": { "$type": "color", "$value": "{palette.blue.68}", "$extensions": { "ayywi": { "light": "{palette.blue.48}" } } },
    "2": { "$type": "color", "$value": "{palette.orange.65}", "$extensions": { "ayywi": { "light": "{palette.orange.40}" } } },
    "3": { "$type": "color", "$value": "{palette.emerald.52}", "$extensions": { "ayywi": { "light": "{palette.green.24}" } } },
    "4": { "$type": "color", "$value": "{palette.violet.77}", "$extensions": { "ayywi": { "light": "{palette.violet.50}" } } },
    "5": { "$type": "color", "$value": "{palette.amber.61}", "$extensions": { "ayywi": { "light": "{palette.amber.37}" } } },
    "6": { "$type": "color", "$value": "{palette.pink.70}", "$extensions": { "ayywi": { "light": "{palette.pink.42}" } } }
  },
  "brand": {
    "$description": "The brand's colour scale, 50 lightest to 950 darkest. Grey until a brand applies (data-brand with @danitesler/ayywi/brands/<name>.css, setBrand(), or brandCss() from `ayywi brand`), which sets it from the brand's seed colour. Same in every theme. For illustrations, hero tints and brand moments; controls use color.primary, which a brand also sets.",
    "50": { "$type": "color", "$value": "{palette.neutral.97}" },
    "100": { "$type": "color", "$value": "{palette.neutral.92}" },
    "200": { "$type": "color", "$value": "{palette.neutral.85}" },
    "300": { "$type": "color", "$value": "{palette.neutral.73}" },
    "400": { "$type": "color", "$value": "{palette.neutral.58}" },
    "500": { "$type": "color", "$value": "{palette.neutral.42}" },
    "600": { "$type": "color", "$value": "{palette.neutral.39}" },
    "700": { "$type": "color", "$value": "{palette.neutral.28}" },
    "800": { "$type": "color", "$value": "{palette.neutral.20}" },
    "900": { "$type": "color", "$value": "{palette.neutral.12}" },
    "950": { "$type": "color", "$value": "{palette.neutral.8}" }
  },
  "font": {
    "heading": { "$type": "fontFamily", "$value": ["Unbounded", "Arial Black", "system-ui", "-apple-system", "Segoe UI", "Roboto", "Noto Sans", "sans-serif"], "$description": "Headings and big numbers. It covers Latin and Cyrillic; other scripts use the system font." },
    "body": { "$type": "fontFamily", "$value": ["Sora", "system-ui", "-apple-system", "Segoe UI", "Roboto", "Noto Sans", "Helvetica Neue", "Arial", "sans-serif"], "$description": "Body and interface text. It always falls back to system fonts, so every language renders." },
    "signature": { "$type": "fontFamily", "$value": ["Caveat", "Segoe Script", "cursive"], "$description": "A handwritten accent for a personal touch. Decorative only, never for interface text." },
    "mono": { "$type": "fontFamily", "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "Monaco", "Consolas", "Noto Sans Mono", "monospace"] }
  },
  "text": {
    "$description": "The type scale. Sizes are relative, so they follow the browser's font size setting.",
    "xs": { "$type": "dimension", "$value": "0.8125rem", "$description": "A small size that stays the same in every density. Prefer s, which grows with density." },
    "s": { "$type": "dimension", "$value": "0.8125rem", "$description": "Small interface text that follows density: badges, table text, menus, captions and group labels.", "$extensions": { "ayywi": { "density": { "comfortable": "0.8125rem", "touch": "0.875rem" } } } },
    "sm": { "$type": "dimension", "$value": "0.875rem", "$description": "Descriptions, and body text in dense interfaces." },
    "md": { "$type": "dimension", "$value": "1rem", "$description": "Body text." },
    "lg": { "$type": "dimension", "$value": "1.125rem", "$description": "The intro under a page or section title." },
    "xl": { "$type": "dimension", "$value": "1.375rem", "$description": "Card titles." },
    "2xl": { "$type": "dimension", "$value": "1.75rem", "$description": "Third-level headings." },
    "3xl": { "$type": "dimension", "$value": "2.25rem", "$description": "Second-level headings." },
    "4xl": { "$type": "dimension", "$value": "3rem", "$description": "Page titles and big metrics." },
    "display": { "$type": "dimension", "$value": "clamp(2.75rem, 13vw, 12.5rem)", "$description": "A hero title that scales smoothly from phone to wide screen. CSS only; platform exports skip it." }
  },
  "weight": {
    "regular": { "$type": "fontWeight", "$value": 400 },
    "medium": { "$type": "fontWeight", "$value": 500 },
    "semibold": { "$type": "fontWeight", "$value": 600 },
    "bold": { "$type": "fontWeight", "$value": 700 }
  },
  "leading": {
    "none": { "$type": "number", "$value": 1 },
    "tight": { "$type": "number", "$value": 1.2 },
    "snug": { "$type": "number", "$value": 1.35 },
    "normal": { "$type": "number", "$value": 1.55 },
    "display": { "$type": "number", "$value": 0.9, "$description": "Tight line height for display titles, so lines read as one block." }
  },
  "tracking": {
    "tight": { "$type": "dimension", "$value": "-0.01em" },
    "wide": { "$type": "dimension", "$value": "0.06em" },
    "eyebrow": { "$type": "dimension", "$value": "0.14em" },
    "display": { "$type": "dimension", "$value": "-0.03em", "$description": "Tighter letter spacing for display titles." }
  },
  "space": {
    "$description": "Spacing steps on a 4px grid. The half steps are only for dense interfaces.",
    "0-5": { "$type": "dimension", "$value": "0.125rem" },
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "1-5": { "$type": "dimension", "$value": "0.375rem" },
    "2": { "$type": "dimension", "$value": "0.5rem" },
    "3": { "$type": "dimension", "$value": "0.75rem" },
    "4": { "$type": "dimension", "$value": "1rem" },
    "5": { "$type": "dimension", "$value": "1.25rem" },
    "6": { "$type": "dimension", "$value": "1.5rem" },
    "8": { "$type": "dimension", "$value": "2rem" },
    "10": { "$type": "dimension", "$value": "2.5rem" },
    "12": { "$type": "dimension", "$value": "3rem" },
    "16": { "$type": "dimension", "$value": "4rem" },
    "20": { "$type": "dimension", "$value": "5rem", "$description": "Generous padding around sections on phones." },
    "24": { "$type": "dimension", "$value": "6rem", "$description": "Generous padding around sections." },
    "32": { "$type": "dimension", "$value": "8rem", "$description": "Generous padding around sections on wide screens." }
  },
  "size": {
    "$description": "Sizes of components. Some change with data-density: compact is the default, and touch screens get touch automatically.",
    "control-sm": { "$type": "dimension", "$value": "1.75rem", "$description": "Small control height.", "$extensions": { "ayywi": { "density": { "comfortable": "2rem", "touch": "2.5rem" } } } },
    "control-md": { "$type": "dimension", "$value": "2rem", "$description": "Default control height.", "$extensions": { "ayywi": { "density": { "comfortable": "2.5rem", "touch": "2.75rem" } } } },
    "control-lg": { "$type": "dimension", "$value": "2.25rem", "$description": "Large control height.", "$extensions": { "ayywi": { "density": { "comfortable": "2.75rem", "touch": "3rem" } } } },
    "switch": { "$type": "dimension", "$value": "1.25rem", "$description": "Height of a switch; its width follows.", "$extensions": { "ayywi": { "density": { "comfortable": "1.375rem", "touch": "1.625rem" } } } },
    "check": { "$type": "dimension", "$value": "1rem", "$description": "Size of a checkbox or radio.", "$extensions": { "ayywi": { "density": { "comfortable": "1.125rem", "touch": "1.25rem" } } } },
    "touch": { "$type": "dimension", "$value": "2.75rem", "$description": "The smallest comfortable target for a finger." },
    "container": { "$type": "dimension", "$value": "87.5rem", "$description": "The widest page content gets: navbar, hero and grids. Used by .ayy-container." },
    "measure": { "$type": "dimension", "$value": "46rem", "$description": "A comfortable width for reading long text. Used by .ayy-prose." },
    "header": { "$type": "dimension", "$value": "4.5rem", "$description": "Height of the navbar; sticky elements and anchor targets sit below it." },
    "icon-sm": { "$type": "dimension", "$value": "1rem", "$description": "Icons in dense rows and beside small text." },
    "icon-md": { "$type": "dimension", "$value": "1.25rem", "$description": "Icons in list rows, headings and beside body text." },
    "icon-lg": { "$type": "dimension", "$value": "1.5rem", "$description": "Icons at their natural size." },
    "icon-xl": { "$type": "dimension", "$value": "2rem", "$description": "Large icons for feature tiles and empty states." }
  },
  "control": {
    "$description": "Text size and side padding of buttons and form controls. They grow a step with each density.",
    "text-sm": { "$type": "dimension", "$value": "0.8125rem", "$extensions": { "ayywi": { "density": { "comfortable": "0.8125rem", "touch": "0.875rem" } } } },
    "text-md": { "$type": "dimension", "$value": "0.8125rem", "$extensions": { "ayywi": { "density": { "comfortable": "0.8125rem", "touch": "0.875rem" } } } },
    "text-field": { "$type": "dimension", "$value": "0.8125rem", "$description": "Text in inputs, textareas and select triggers. It grows on touch screens so iOS doesn't zoom in when you focus them.", "$extensions": { "ayywi": { "density": { "comfortable": "0.8125rem", "touch": "1rem" } } } },
    "text-lg": { "$type": "dimension", "$value": "0.875rem", "$extensions": { "ayywi": { "density": { "comfortable": "0.9375rem", "touch": "1rem" } } } },
    "pad-sm": { "$type": "dimension", "$value": "0.75rem", "$extensions": { "ayywi": { "density": { "comfortable": "0.875rem", "touch": "1rem" } } } },
    "pad-md": { "$type": "dimension", "$value": "1rem", "$extensions": { "ayywi": { "density": { "comfortable": "1.125rem", "touch": "1.25rem" } } } },
    "pad-lg": { "$type": "dimension", "$value": "1.25rem", "$extensions": { "ayywi": { "density": { "comfortable": "1.5rem", "touch": "1.75rem" } } } }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "4px" },
    "md": { "$type": "dimension", "$value": "6px" },
    "lg": { "$type": "dimension", "$value": "8px" },
    "xl": { "$type": "dimension", "$value": "12px" },
    "2xl": { "$type": "dimension", "$value": "16px" },
    "3xl": { "$type": "dimension", "$value": "24px" },
    "pill": { "$type": "dimension", "$value": "999px" },
    "control": { "$type": "dimension", "$value": "{radius.xl}", "$description": "Corners of inputs, selects, textareas, tooltips and menus." },
    "card": { "$type": "dimension", "$value": "{radius.2xl}", "$description": "Corners of cards, dialogs and popovers." },
    "button": { "$type": "dimension", "$value": "{radius.pill}", "$description": "Corners of buttons, tabs, segmented controls, chips, badges and pagination links. A brand's shape sets it together with control and card." }
  },
  "shadow": {
    "rest": { "$type": "shadow", "$value": "inset 0 1px 0 #ffffff0f", "$description": "A light edge along the top, for cards at rest.", "$extensions": { "ayywi": { "light": "inset 0 1px 0 #0a0a0a0f", "css": "inset 0 1px 0 var(--ayy-color-highlight)" } } },
    "lift": { "$type": "shadow", "$value": "0 16px 36px #00000066", "$description": "Cards that are hovered or lifted.", "$extensions": { "ayywi": { "light": "0 16px 36px #0000001f", "css": "0 16px 36px color-mix(in srgb, var(--ayy-color-shadow) 40%, transparent)" } } },
    "overlay": { "$type": "shadow", "$value": "0 24px 60px #00000080", "$description": "Anything floating over the page: dialogs, menus, popovers, tooltips and toasts.", "$extensions": { "ayywi": { "light": "0 24px 60px #00000026", "css": "0 24px 60px color-mix(in srgb, var(--ayy-color-shadow) 50%, transparent)" } } },
    "glow": { "$type": "shadow", "$value": "0 0 18px #ffffff2e", "$description": "The soft glow when a primary button is hovered.", "$extensions": { "ayywi": { "light": "0 0 18px #0000001a", "css": "0 0 18px color-mix(in srgb, var(--ayy-color-glow) 18%, transparent)" } } },
    "frame": { "$type": "shadow", "$value": "0 30px 80px -40px #000000e6", "$description": "A long, soft shadow under screenshots and browser frames.", "$extensions": { "ayywi": { "light": "0 30px 80px -40px #0000004d", "css": "0 30px 80px -40px color-mix(in srgb, var(--ayy-color-shadow) 90%, transparent)" } } }
  },
  "ease": {
    "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1], "$description": "The everyday curve: quick start, gentle stop. Hover and colour changes, and loops that repeat." },
    "spring": { "$type": "cubicBezier", "$value": [0.175, 0.885, 0.32, 1.275], "$description": "Overshoots a little before settling, so small things like toggles feel springy." },
    "out-expo": { "$type": "cubicBezier", "$value": [0.25, 1, 0.5, 1], "$description": "A fast start and a long, soft landing. For things arriving or lifting, like cards." },
    "menu": { "$type": "cubicBezier", "$value": [0.22, 1, 0.36, 1], "$description": "A smooth curve for panels that open and close: menus, dialogs and popovers." }
  },
  "duration": {
